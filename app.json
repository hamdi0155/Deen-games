{
  "expo": {
    "name": "Ascend",
    "slug": "ascend-life-rpg",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ascend",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07090F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ascend.liferPG",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Ascend uses the camera for profile photos.",
        "NSPhotoLibraryUsageDescription": "Ascend accesses your photo library for profile photos.",
        "UIRequiresFullScreen": true,
        "UIStatusBarStyle": "UIStatusBarStyleLightContent"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07090F"
      },
      "package": "com.ascend.liferpg",
      "versionCode": 1,
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/Deen-games"
    },
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
